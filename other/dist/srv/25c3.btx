<!-- This ia an example page that illustrate how a CEPT TCD 6-1
     looks when it is formatted in the btxml hypertext language

     Propose: How to use the different character sets -->

<cept>						<!-- Open CEPT page -->
<head>						<!-- This is the header, it contains meta information for service control -->
<meta name="next_page" content="*25c3d1a#">	<!-- Define the page that is loaded when '#' is pressed -->

<meta name="hyperlinks" content="10*25c3d1a#,20*25c3d2a#,30*25c3d3a#,40*25c3d4a#">
<meta name="hyperlinks" content="42*0#,10*0#,20*0#,30*0#,40*0#">


</head>						<!-- Close the header -->
<body>						<!-- Open page body segment -->


<!-- First we care about a Black/White ambient -->
<cs>						<!-- Clear screen -->
<csi><0x30><0x40>				<!-- Invoke 1nd color table -->
<esc><0x23><0x20><fwhb>				<!-- Makes the background blue -->
<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->



<trb><bkf>					<!-- Select Transparent background with white foreground -->

<esc><0x28><0x63><0x0f> 				<!-- Invoke G1 set -->

