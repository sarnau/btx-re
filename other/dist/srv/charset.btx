<!-- This ia an example page that illustrate how a CEPT TCD 6-1
     looks when it is formatted in the btxml hypertext language

     Propose: How to use the different character sets -->

<cept>						<!-- Open CEPT page -->
<head>						<!-- This is the header, it contains meta information for service control -->
<meta name="next_page" content="*testbild#">	<!-- Define the page that is loaded when '#' is pressed -->
</head>						<!-- Close the header -->
<body>						<!-- Open page body segment -->

<!-- DRCS Pixel data (Btx-logo, 6 tiles) -->
<us><0x2f>
<us><0x23><0x20> <0x28><0x20><0x40> <0x47><0x41>
<us><0x23>!
<0x30><0x40><0x40><0x40><0x40><0x43><0x7f><0x4c><0x40><0x70><0x40><0x70><0x4f><0x70><0x7f><0x71><0x7f><0x70><0x7c><0x70><0x40>
<0x30><0x40><0x40><0x40><0x40><0x7f><0x7f><0x40><0x40><0x40><0x40><0x7f><0x7f><0x7f><0x7f><0x40><0x40><0x43><0x70><0x4f><0x7c>
<0x30><0x40><0x40><0x40><0x40><0x7f><0x70><0x40><0x4c><0x40><0x43><0x7c><0x43><0x7f><0x43><0x7f><0x63><0x4f><0x43><0x40><0x43>
<0x30><0x70><0x4f><0x70><0x7f><0x70><0x7f><0x70><0x7f><0x70><0x7f><0x70><0x40><0x4c><0x40><0x43><0x7f><0x40><0x40><0x40><0x40>
<0x30><0x4f><0x7c><0x4f><0x7c><0x73><0x73><0x7c><0x4f><0x7f><0x7f><0x40><0x40><0x40><0x40><0x7f><0x7f><0x40><0x40><0x40><0x40>
<0x30><0x7c><0x43><0x7f><0x43><0x7f><0x43><0x7f><0x43><0x7f><0x43><0x40><0x43><0x40><0x4c><0x7f><0x70><0x40><0x40><0x40><0x40>
<us>AA

<!-- First we care about a White/Blue ambient -->
<cs><aph>					<!-- Clear screen -->
<csi><0x31><0x40>				<!-- Invoke 2nd color table (to get deep blue) -->
<esc><0x23><0x20><fblb>				<!-- Makes the background blue -->
<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->

<!-- Headline -->
<esc><0x22><0x41>				<!-- Invoke C1P set -->
<csi><0x30><0x40>				<!-- Invoke 1nd color table -->
<trb><whf>
<esc><0x28><0x20><0x40><0x0f>			<!-- Invoke DRCS set -->
!"#<apd><apr>
$%&<apu><apf>
<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->
<apd><dbh>Bildschirmtrix<apd><apr>
<esc><0x23><0x21><fblb>				<!-- Maks a blue full row -->
<apd>
<esc><0x23><0x21><fblb>				<!-- Maks a blue full row -->
<csi><0x31><0x40>				<!-- Invoke 2nd color table -->
<dbh><apr>Testbild:<sp>Zeichens<ss2>Hatze<sp><sp><sp><sp><sp><sp><sp><sp><sp>*charset#<apd><apr>
<csi><0x30><0x40>				<!-- Invoke 1nd color table -->
<nsz><trb><whf>
<apd><apr>

<!-- Content -->
<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set (just activate, only for a better understanding) -->
<grb><bkf>G0-SET:<whf><trb>			<!-- Green foreground with black background and back -->
<sp><bkb>!"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~<trb><apd><apr>
<apd><apr>

<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->
<grb><bkf>G1-SET:<whf><trb>			<!-- Green foreground with black background and back -->
<esc><0x28><0x63><0x0f>				<!-- Invoke G1 set -->
<sp><bkb>!"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~<trb><apd><apr>
<apd><apr>

<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->
<grb><bkf>G2-SET:<whf><trb>			<!-- Green foreground with black background and back -->
<esc><0x28><0x62><0x0f>				<!-- Invoke G2 set -->
<sp><bkb>!"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~<trb><apd><apr>
<apd><apr>

<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->
<grb><bkf>G3-SET:<whf><trb>			<!-- Green foreground with black background and back -->
<esc><0x28><0x64><0x0f>				<!-- Invoke G3 set -->
<sp><bkb>!"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~<trb><apd><apr>
<apd><apr>
<esc><0x28><0x40><0x0f>				<!-- Invoke G0 set -->

<!-- Input prompt -->
<esc><0x23><0x21><fblb>				<!-- Maks a blue full row -->
Weiter<sp>mit<sp>#<sp><sp>oder<sp><sp>*Seitennummer#<apd><apr>
Eingabe<sp>==><sp>



</body>						<!-- Close page body segment -->
</cept>						<!-- Close CEPT page -->
