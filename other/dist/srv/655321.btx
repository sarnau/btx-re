<!-- This a remake of the CCC BTX Page i reconstructed from a picture i found at  -->
<!-- http://ausgehackt.c3t.de/category/hacks/ -->
<!-- http://ausgehackt.c3t.de/wp-content/uploads/2009/09/Ccc_btx-450x298.jpg -->

<cept>						<!-- Open CEPT page -->
<head>						<!-- This is the header, it contains meta information for service control -->
<meta name="next_page" content="*chaos#">	<!-- Define the page that is loaded when '#' is pressed -->
<meta name="hyperlinks" content="01*raumpflege#,02*raumpflege#,04*raumpflege#,05*raumpflege#,06*raumpflege#,07*raumpflege#,08*raumpflege#,09*raumpflege#">
</head>						<!-- Close the header -->
<body>						<!-- Open page body segment -->


<!-- Load DRCS -->
<us> <0x2f>
<us> <0x23><0x20> <0x28><0x20><0x40> <0x4b><0x41>
<us> <0x23>!
<0x30><0x40><0x5f><0x60><0x67><0x69><0x68><0x68><0x68><0x68><0x68>
